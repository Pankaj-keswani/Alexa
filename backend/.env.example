# PhoneBridge Backend Configuration
PORT=3000
HOST=0.0.0.0

# Device Authentication Token
# This secret must match the token configured in the Android app Settings.
DEVICE_TOKEN=dev_token_secret_123

# Alexa Integration Secret
# Used to authenticate requests originating from the Alexa Skill backend.
ALEXA_CLIENT_SECRET=alexa_skill_secret_456

# Optional: Default target device ID if multiple devices connect
DEFAULT_DEVICE_ID=

# Environment
NODE_ENV=development
